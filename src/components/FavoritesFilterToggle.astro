---
export interface Props {
  label: string;
  // Shorter label shown on mobile so Favorites fits on one row with Sort and
  // the tag filter; the full label returns at sm+.
  shortLabel: string;
}

const { label, shortLabel } = Astro.props;
---

{/* A shorter label on mobile (full "Favorites only" returns at sm+) so this,
    Sort and the tag toggle all fit on one row. aria-label always carries the
    full name. */}
<button
  type="button"
  id="favorites-filter-toggle"
  data-active="false"
  aria-pressed="false"
  aria-label={label}
  class="group flex h-12 items-center gap-1.5 rounded-lg border border-gray-300 px-3 text-sm text-gray-600 transition hover:bg-gray-100 data-[active=true]:border-pink-400 data-[active=true]:bg-pink-100 data-[active=true]:text-pink-700 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700 dark:data-[active=true]:bg-pink-900 dark:data-[active=true]:text-pink-200 sm:h-11 sm:px-4"
>
  <svg class="w-4 h-4 group-data-[active=true]:hidden" aria-hidden="true"><use href="#icon-heart-outline"/></svg>
  <svg class="hidden w-4 h-4 group-data-[active=true]:block" aria-hidden="true"><use href="#icon-heart-filled"/></svg>
  <span class="sm:hidden">{shortLabel}</span>
  <span class="hidden sm:inline">{label}</span>
</button>

<script is:inline>
  function bindFavoritesFilterToggle() {
    const button = document.getElementById('favorites-filter-toggle');
    if (!button || button.dataset.toggleBound) return;
    button.dataset.toggleBound = 'true';

    button.addEventListener('click', () => {
      const active = button.dataset.active === 'true';
      button.dataset.active = String(!active);
      button.setAttribute('aria-pressed', String(!active));
      if (window.applyRecipeGridFilters) window.applyRecipeGridFilters();
    });
  }

  document.addEventListener('astro:page-load', bindFavoritesFilterToggle);
</script>
