---
export interface Props {
  // Tags for this locale, already ordered most-used first (see the index page).
  tags: string[];
  clearLabel: string;
}

const { tags, clearLabel } = Astro.props;
---

{/*
  Full-width chip panel, collapsed by default. Placed as a `basis-full` flex
  item in the toolbar so it wraps onto its own line below the controls when
  opened. Selecting chips narrows the grid (AND — a recipe must carry every
  selected tag) via the shared filter in BaseLayout; selections stay active
  even while collapsed, surfaced by the count badge on the toggle.
*/}
<div id="tag-filter-panel" class="mt-3 hidden basis-full flex-wrap items-center gap-2">
  {tags.map((tag) => (
    <button
      type="button"
      data-tag-key={tag.toLowerCase()}
      data-active="false"
      aria-pressed="false"
      class="h-8 rounded-full border border-gray-300 px-3 text-sm text-gray-600 transition hover:bg-gray-100 data-[active=true]:border-pink-400 data-[active=true]:bg-pink-100 data-[active=true]:text-pink-700 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700 dark:data-[active=true]:bg-pink-900 dark:data-[active=true]:text-pink-200"
    >
      #{tag}
    </button>
  ))}
  <button
    type="button"
    id="tag-filter-clear"
    class="ml-1 hidden text-sm font-medium text-pink-600 hover:underline dark:text-pink-400"
  >
    {clearLabel}
  </button>
</div>

<script is:inline>
  function bindTagFilter() {
    const panel = document.getElementById('tag-filter-panel');
    const toggle = document.getElementById('tag-filter-toggle');
    if (!panel || !toggle || panel.dataset.tagFilterBound) return;
    panel.dataset.tagFilterBound = 'true';

    const count = document.getElementById('tag-filter-count');
    const clear = document.getElementById('tag-filter-clear');

    // Panel uses `hidden basis-full flex-wrap`, so toggling `hidden` also
    // restores `flex` (and its basis-full makes it wrap to a full-width row).
    function setOpen(open) {
      panel.classList.toggle('hidden', !open);
      panel.classList.toggle('flex', open);
      toggle.setAttribute('aria-expanded', String(open));
    }

    function refresh() {
      const active = panel.querySelectorAll('[data-active="true"]').length;
      count.textContent = String(active);
      count.classList.toggle('hidden', active === 0);
      clear.classList.toggle('hidden', active === 0);
    }

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.addEventListener('click', (e) => {
      const chip = e.target.closest('button[data-tag-key]');
      if (!chip) return;
      const active = chip.dataset.active !== 'true';
      chip.dataset.active = String(active);
      chip.setAttribute('aria-pressed', String(active));
      refresh();
      if (window.applyRecipeGridFilters) window.applyRecipeGridFilters();
    });

    clear.addEventListener('click', () => {
      for (const chip of panel.querySelectorAll('[data-active="true"]')) {
        chip.dataset.active = 'false';
        chip.setAttribute('aria-pressed', 'false');
      }
      refresh();
      if (window.applyRecipeGridFilters) window.applyRecipeGridFilters();
    });
  }

  document.addEventListener('astro:page-load', bindTagFilter);
</script>
