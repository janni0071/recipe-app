---
export interface Props {
  slug: string;
  label: string;
  // Feedback-toast copy + destination, baked on server-side so they're already
  // localized when the client-side click handler reads them (see BaseLayout).
  addedLabel?: string;
  removedLabel?: string;
  viewLabel?: string;
  listHref?: string;
  class?: string;
}

const {
  slug,
  label,
  addedLabel,
  removedLabel,
  viewLabel,
  listHref,
  class: className = 'bg-pink-100 hover:bg-pink-200 dark:bg-pink-900 dark:hover:bg-pink-800 text-pink-600 dark:text-pink-300',
} = Astro.props;
---

<button
  type="button"
  data-shopping-slug={slug}
  data-in-list="false"
  data-added-label={addedLabel}
  data-removed-label={removedLabel}
  data-view-label={viewLabel}
  data-list-href={listHref}
  aria-pressed="false"
  aria-label={label}
  class={`group relative flex-shrink-0 p-3 rounded-full transition ${className}`}
>
  <svg class="w-5 h-5" aria-hidden="true"><use href="#icon-cart"/></svg>
  <span class="hidden group-data-[in-list=true]:flex absolute -top-1 -right-1 w-4 h-4 items-center justify-center rounded-full bg-green-500 ring-2 ring-pink-100 dark:ring-pink-900">
    <svg class="w-2.5 h-2.5 text-white" aria-hidden="true"><use href="#icon-check"/></svg>
  </span>
</button>
